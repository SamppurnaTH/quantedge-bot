# Environment — never commit credentials
.env
.env.*
!.env.example

# Generated data cache and artifacts
/data/raw/
/data/processed/
*.csv
*.json
!/state/
!state/*.json
!state/*.csv
!state/.gitkeep

# Logs — generated at runtime
/logs/
*.log

# Python bytecode and build artifacts
