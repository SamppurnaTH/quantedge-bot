*.py[cod]
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE/editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

